{
  "description": "Speak when Codex needs input or finishes a turn.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "request_user_input|RequestUserInput",
        "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/dist/voice-mcp.mjs\" hook", "timeout": 10 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/dist/voice-mcp.mjs\" hook", "timeout": 10 }]
      }
    ]
  }
}
