{
  "description": "Speak when Claude needs input, finishes a turn, or stops on an API error.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/voice-mcp.mjs\" hook", "timeout": 10 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/voice-mcp.mjs\" hook", "timeout": 10 }]
      }
    ],
    "StopFailure": [
      {
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/voice-mcp.mjs\" hook", "timeout": 10 }]
      }
    ]
  }
}
